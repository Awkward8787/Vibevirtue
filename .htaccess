DirectoryIndex index.html
Options -Indexes

# Serve the app shell for client-routed paths (required for direct
# navigation and refresh on legal pages and unknown URLs).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Correct MIME type for the web manifest.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# Hashed build assets can be cached forever; HTML must always revalidate
# so a new deployment is picked up immediately.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
